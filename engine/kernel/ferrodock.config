# What Ferrodock's engine needs on top of LinuxKit's kernel config.
# One OPTION=value per line (without the CONFIG_ prefix).

# Sharing the Mac's folders with Apple's virtiofs (it has no DAX window,
# so FUSE_DAX isn't needed).
VIRTIO_FS=y
# The engine's socket reaches the Mac over vsock, from the first moment.
VSOCKETS=y
VIRTIO_VSOCKETS=y
